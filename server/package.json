{
  "name": "embroidery-billing-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc && cp -r src/migrations dist/",
    "start": "node --env-file=.env dist/index.js",
    "migrate": "tsx --env-file=.env src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env.test --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
