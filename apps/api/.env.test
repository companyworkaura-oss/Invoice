DATABASE_URL=postgres://app:app@localhost:5432/embroidery_test
PORT=4000
# Set to "true" behind HTTPS in production so the session cookie is Secure.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Path to a Chromium executable, used to render invoice PDFs (playwright-core).
CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium
# The test suite legitimately registers/logs in far more than a real
# client would in the same window — see middleware/rate-limit.ts.
RATE_LIMIT_DISABLED=true
