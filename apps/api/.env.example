DATABASE_URL=postgres://app:app@localhost:5432/embroidery
PORT=4000
# Set to "true" behind HTTPS in production so the session cookie is Secure.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Path to a Chromium executable, used to render invoice PDFs (playwright-core).
CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium
