# development | test | production. Controls cookie-security warnings,
# request-log verbosity, and other environment-specific behavior. Set to
# "production" in a real deployment — see DEPLOYMENT.md.
NODE_ENV=development
DATABASE_URL=postgres://app:app@localhost:5432/embroidery
PORT=4000
# Set to "true" behind HTTPS in production so the session cookie is Secure.
# The app warns loudly on boot if NODE_ENV=production and this is not "true".
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Path to a Chromium executable, used to render invoice PDFs (playwright-core).
CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium
# Leave unset (or "false") in production and dev — only the test env sets
# this to "true", since the test suite legitimately registers/logs in far
# more than a real client would in the same window.
RATE_LIMIT_DISABLED=false
# Set to "true" to have this API process serve the built frontend
# (apps/web/dist) directly, for a single-process deployment. Leave unset
# (or "false") if the frontend is deployed separately (e.g. a static
# host/CDN) — see DEPLOYMENT.md.
SERVE_FRONTEND=false
WEB_DIST_DIR=../web/dist
